{
  "version": 2,
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/mobile/(.*)", "dest": "/web/dist/mobile/$1" },
    { "src": "/(.*)", "dest": "/web/dist/$1" }
  ]
}
